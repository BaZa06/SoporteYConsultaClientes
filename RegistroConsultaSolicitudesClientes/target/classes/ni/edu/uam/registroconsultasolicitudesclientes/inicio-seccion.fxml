<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="245.0" prefWidth="519.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registroconsultasolicitudesclientes.controller.InicioSeccionController">
   <children>
      <Label layoutX="198.0" layoutY="41.0" text="Inicio de Sección">
         <font>
            <Font name="Baskerville Old Face" size="24.0" />
         </font>
      </Label>
      <Label layoutX="89.0" layoutY="99.0" text="Usuario:">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtUsuario" layoutX="144.0" layoutY="95.0" prefHeight="26.0" prefWidth="318.0" promptText="Ingrese su nombre de usuario">
         <font>
            <Font name="Baskerville Old Face" size="12.0" />
         </font>
      </TextField>
      <Label layoutX="70.0" layoutY="139.0" text="Contraseña:">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Label>
      <PasswordField fx:id="pwdPassword" layoutX="143.0" layoutY="135.0" prefHeight="26.0" prefWidth="318.0" promptText="Ingrese su contraseña" />
      <Button fx:id="btnIniciarSeccion" layoutX="144.0" layoutY="180.0" mnemonicParsing="false" onAction="#iniciarSeccion" text="Iniciar sección">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Button>
      <Button fx:id="btnSalir" layoutX="280.0" layoutY="180.0" mnemonicParsing="false" onAction="#salirInicioSeccion" prefHeight="28.0" prefWidth="114.0" text="Salir">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
