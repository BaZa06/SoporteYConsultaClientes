<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="848.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registroconsultasolicitudesclientes.controller.RegistroClientesController">
   <children>
      <Label layoutX="208.0" layoutY="32.0" text="Registro de clientes">
         <font>
            <Font name="Baskerville Old Face" size="24.0" />
         </font>
      </Label>
      <Label layoutX="75.0" layoutY="84.0" text="Nombre:">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtNombre" layoutX="143.0" layoutY="80.0" prefHeight="26.0" prefWidth="338.0" promptText="Ingrese sus nombres">
         <font>
            <Font name="Baskerville Old Face" size="12.0" />
         </font>
      </TextField>
      <Label layoutX="75.0" layoutY="123.0" text="Apellidos:">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtApellido" layoutX="143.0" layoutY="119.0" prefHeight="26.0" prefWidth="338.0" promptText="Ingrese sus apellidos">
         <font>
            <Font name="Baskerville Old Face" size="12.0" />
         </font>
      </TextField>
      <Label layoutX="72.0" layoutY="161.0" text="Tipo de clientes:">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Label>
      <ComboBox fx:id="cmbTipoClientes" layoutX="177.0" layoutY="157.0" prefHeight="26.0" prefWidth="302.0" promptText="Seleccione una opción" />
      <Label layoutX="72.0" layoutY="202.0" text="Fecha de nacimiento:">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Label>
      <DatePicker fx:id="dtpFechaNacimiento" layoutX="201.0" layoutY="199.0" prefHeight="26.0" prefWidth="280.0" />
      <Label layoutX="66.0" layoutY="237.0" text="Tipo de solicitud:">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Label>
      <RadioButton fx:id="rbtnConsultaInformacion" layoutX="179.0" layoutY="238.0" mnemonicParsing="false" text="Consulta de información" />
      <RadioButton fx:id="rbtnSolicitudCotizacion" layoutX="179.0" layoutY="263.0" mnemonicParsing="false" text="Solicitud de cotización" />
      <RadioButton fx:id="rbtnContratacionServicio" layoutX="179.0" layoutY="289.0" mnemonicParsing="false" text="Contratación de servicio" />
      <RadioButton fx:id="rbtnSoporteTecnico" layoutX="179.0" layoutY="313.0" mnemonicParsing="false" text="Soporte técnico" />
      <RadioButton fx:id="rbtnReclamo" layoutX="179.0" layoutY="337.0" mnemonicParsing="false" text="Reclamo" />
      <RadioButton fx:id="rbtnOtro" layoutX="179.0" layoutY="361.0" mnemonicParsing="false" text="Otro" />
      <Label layoutX="48.0" layoutY="393.0" text="Servicios de interés:">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Label>
      <CheckBox fx:id="chkInternet" layoutX="176.0" layoutY="394.0" mnemonicParsing="false" text="Internet" />
      <CheckBox fx:id="chkTelefonia" layoutX="176.0" layoutY="421.0" mnemonicParsing="false" text="Telefonía" />
      <CheckBox fx:id="chkTelevision" layoutX="177.0" layoutY="449.0" mnemonicParsing="false" text="Televisión" />
      <CheckBox fx:id="chkSoporteTecnico" layoutX="177.0" layoutY="477.0" mnemonicParsing="false" text="Soporte técnico" />
      <CheckBox fx:id="chkInstalacion" layoutX="177.0" layoutY="502.0" mnemonicParsing="false" text="Instalación" />
      <Label layoutX="55.0" layoutY="571.0" text="Fotografia:">
         <font>
            <Font name="Baskerville Old Face" size="14.0" />
         </font>
      </Label>
      <ImageView fx:id="imgFotografia" fitHeight="103.0" fitWidth="141.0" layoutX="132.0" layoutY="538.0" pickOnBounds="true" preserveRatio="true" />
      <Button fx:id="btnSeleccionarFoto" layoutX="257.0" layoutY="651.0" mnemonicParsing="false" onAction="#seleccionarFoto" text="Seleccionar" />
      <TextField fx:id="txtSeleccionarFoto" editable="false" layoutX="84.0" layoutY="651.0" prefHeight="26.0" prefWidth="158.0" promptText="Seleccione una imagen" />
      <Button fx:id="btnGuardar" layoutX="88.0" layoutY="699.0" mnemonicParsing="false" onAction="#guardarSolicitud" text="Guardar" />
      <Button fx:id="btnLimpiar" layoutX="171.0" layoutY="699.0" mnemonicParsing="false" onAction="#limpiarControles" text="Limpiar" />
      <Button fx:id="btnCancelar" layoutX="255.0" layoutY="699.0" mnemonicParsing="false" onAction="#cancelarSolicitud" text="Cancelar" />
   </children>
</AnchorPane>
